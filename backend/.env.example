# Copy this file to .env and adjust.

# --- Database -------------------------------------------------------------
# PostgreSQL (recommended). Create the database first:  createdb finora
DATABASE_URL=postgresql+psycopg2://localhost:5432/finora
# Leave DATABASE_URL unset to fall back to a local SQLite file (zero setup).

# --- AI CFO (local model through Ollama) -----------------------------------
LLM_PROVIDER=ollama          # ollama | none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b      # local Qwen 2.5 (3B). Remote/cloud models are refused.

# --- Security ---------------------------------------------------------------
PAN_PEPPER=change-this-to-a-long-random-string
# FINORA_ENV=development        # production: refuses default secrets, requires COOKIE_SECURE=true
# COOKIE_SECURE=false           # true when served over HTTPS
# SESSION_TTL_HOURS=168
# SANDBOX_TTL_HOURS=24
# UPLOAD_MAX_BYTES=5000000
# LOGIN_MAX_FAILURES=5          # per e-mail per LOGIN_WINDOW_SECONDS (900)
# ENABLE_RETRAIN_ENDPOINT=true  # default false in production
